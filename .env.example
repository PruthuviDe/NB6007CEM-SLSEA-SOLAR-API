# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/slsea_solar_db?retryWrites=true&w=majority

# Security & Authentication (JWT)
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Base API URL
BASE_URL=http://localhost:5000
